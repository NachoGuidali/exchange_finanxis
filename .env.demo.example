# .env para la DEMO en PythonAnywhere (cuenta free). Copiar a .env y completar USUARIO.
# Datos ficticios: nunca subir la base ni los archivos reales a la demo.

SECRET_KEY=generar-con-get_random_secret_key
DEBUG=False
ALLOWED_HOSTS=USUARIO.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=https://USUARIO.pythonanywhere.com
SITE_URL=https://USUARIO.pythonanywhere.com

# El HTTPS lo pone PythonAnywhere ("Force HTTPS" en la pestaña Web)
SECURE_SSL_REDIRECT=False
# PythonAnywhere tiene un proxy adelante: la IP real viene en X-Forwarded-For
AXES_IPWARE_PROXY_COUNT=1

# Modo demo
DEMO_MODE=True
# Sin Celery: la cotización se actualiza al entrar a Operar cuando está vencida
COTIZACION_ACTUALIZAR_AL_VUELO=True
# Si WeasyPrint no puede generar PDFs en el servidor, las operaciones siguen sin boleto
BOLETOS_TOLERAR_ERROR_PDF=True
# Los mails van a la consola: guardamos los links de verificación en verification_links.log
DEMO_SAVE_VERIFICATION_LINK=True

# Sin DB_NAME → SQLite (PostgreSQL no está disponible en la cuenta free)
